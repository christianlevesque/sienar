@inject IUserAccessor UserAccessor

<footer class="conainer-fluid">
	<div class="row gx-0">
		@if (UserAccessor.IsSignedIn())
		{
			<a
				class="col-12 btn btn-primary"
				asp-area="Dashboard"
				asp-page="/Account/LogOut">
				Log out
			</a>
		}
		else
		{
			<a
				class="col-12 btn btn-outline-secondary"
				asp-area="Dashboard"
				asp-page="/Account/Register">
				Register
			</a>
			<a
				class="col-12 btn btn-primary"
				asp-area="Dashboard"
				asp-page="/Account/Login">
				Log in
			</a>
		}
	</div>
</footer>
