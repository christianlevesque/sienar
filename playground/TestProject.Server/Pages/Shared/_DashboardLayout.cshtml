@inject IOptions<SienarOptions> Options
@inject IMenuGenerator MenuGenerator
@inject IUserAccessor UserAccessor

@{
	var menuName = ViewData.ContainsKey(CorePluginConstants.ViewData.Menu) ? ViewData[CorePluginConstants.ViewData.Menu]!.ToString()! : string.Empty;

	var menus = MenuGenerator.Create(menuName);
}

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1.0"/>

	<title>@ViewData[CorePluginConstants.ViewData.Title] | @Options.Value.SiteName</title>
	<script src="http://localhost:5173/@@vite/client" type="module"></script>
	<script src="http://localhost:5173/src/main.ts" type="module"></script>
</head>

<body>
<div class="d-flex min-vh-100">
	<div
		id="menu"
		class="menu offcanvas-lg offcanvas-start bg-dark text-light border-end border-dark p-4 d-flex flex-column"
		tabindex="-1"
		aria-labelledby="menu-title"
		style="width: 300px">

		<div class="offcanvas-body flex-grow-1 flex-column">

			<ul class="list-unstyled flex-grow-1">
				@foreach (var menu in menus)
				{
					<li>
						<a
							href="@menu.Url"
							class="d-block text-light text-decoration-none fs-4">
							@if (!string.IsNullOrEmpty(menu.Icon))
							{
								<i class="me-4 bi bi-@menu.Icon"></i>
							}

							@menu.Text
						</a>
					</li>
				}
			</ul>

			<footer class="conainer-fluid">
				<div class="row gx-0">
					@if (UserAccessor.IsSignedIn())
					{
						<a
							class="col-12 btn btn-primary"
							asp-area="Dashboard"
							asp-page="/Account/LogOut">
							Log out
						</a>
					}
					else
					{
						<a
							class="col-12 btn btn-outline-secondary"
							asp-area="Dashboard"
							asp-page="/Account/Register">
							Register
						</a>
						<a
							class="col-12 btn btn-primary"
							asp-area="Dashboard"
							asp-page="/Account/Login">
							Log in
						</a>
					}
				</div>
			</footer>

		</div>

	</div>

	<div class="flex-grow-1">
		@RenderBody()
	</div>
</div>

<script asp-src-include="@(ViewContext.View.Path).js" asp-append-version="true" type="module"></script>
</body>
</html>
