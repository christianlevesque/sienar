@inject IOptions<SienarOptions> Options
@inject IMenuGenerator MenuGenerator
@inject IUserAccessor UserAccessor

@{
	var menuName = ViewData.ContainsKey(CorePluginConstants.ViewData.Menu) ? ViewData[CorePluginConstants.ViewData.Menu]!.ToString()! : string.Empty;

	var menus = MenuGenerator.Create(menuName);
}

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1.0"/>

	<title>@ViewData[CorePluginConstants.ViewData.Title] | @Options.Value.SiteName</title>
	<script src="http://localhost:5173/@@vite/client" type="module"></script>
	<script src="http://localhost:5173/src/main.ts" type="module"></script>
</head>

<body>
<div
	id="app"
	class="app d-flex flex-row">
	<div class="sidebar">
		<div class="flex-grow-1">
			<ul class="menu heavy">
				@foreach (var menu in menus)
				{
					<li>
						<a href="@menu.Url">
							@if (!string.IsNullOrEmpty(menu.Icon))
							{
								<span class="mdi mdi-@menu.Icon"></span>
							}

							@menu.Text
						</a>
					</li>
				}
			</ul>
		</div>

		<div>
			@if (UserAccessor.IsSignedIn())
			{
				<a
					class="button button--primary d-block"
					asp-area="Dashboard"
					asp-page="/Account/LogOut">
					Log out
				</a>
			}
			else
			{
				<a
					class="btn secondary outlined d-block mb-4"
					asp-area="Dashboard"
					asp-page="/Account/Register">
					Register
				</a>
				<a
					class="btn primary d-block"
					asp-area="Dashboard"
					asp-page="/Account/Login">
					Log in
				</a>
			}
		</div>
	</div>

	<div class="window">
		<header class="appbar">
			<button class="d-lg-none btn primary text">
				<i class="mdi mdi-menu"></i>
			</button>
		</header>

		<main class="main">
			<container class="p-4">
				@RenderBody()
			</container>
		</main>
	</div>
</div>

<div id="notification-container" class="notifications"></div>
<div id="modal-container" class="modal-container"></div>

<script asp-src-include="@(ViewContext.View.Path).js" asp-append-version="true" type="module"></script>
</body>
</html>
